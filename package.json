{
  "name": "parchment",
  "version": "0.0.1",
  "description": "Parchment: a historical timeline atlas for the classroom. Live map, fixed stages, snapshot years, trackers, diff view, slide-ready exports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Wil Cosgrove",
  "scripts": {
    "fetch": "node scripts/fetch-base.mjs",
    "derive": "node scripts/derive.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "shot": "node scripts/screenshot.mjs",
    "offline": "node scripts/build-offline.mjs",
    "check": "node scripts/check-records.mjs",
    "geocode": "node scripts/geocode.mjs",
    "sheet": "node scripts/make-sheet.mjs",
    "pull": "node scripts/pull-sheet.mjs",
    "fetch:us": "node scripts/fetch-us.mjs",
    "derive:us": "node --max-old-space-size=8192 scripts/derive-us.mjs",
    "derive:native": "node scripts/derive-native.mjs",
    "app": "electron .",
    "app:build": "electron-builder --win portable",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "map": "node scripts/map.mjs",
    "film": "node scripts/film.mjs",
    "describe": "node scripts/lookup.mjs describe",
    "changes": "node scripts/lookup.mjs changes",
    "search": "node scripts/lookup.mjs search",
    "derive:sources": "node scripts/derive-ohm-sources.mjs",
    "derive:disputes": "node scripts/derive-us-disputes.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "geotiff": "^3.0.5",
    "osmtogeojson": "^3.0.0-beta.5",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "shapefile": "^0.6.6",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.parchment.atlas",
    "productName": "Parchment",
    "copyright": "Wil Cosgrove",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**",
      "index.html",
      "admin.html",
      "us.html",
      "app.js",
      "admin.js",
      "us.js",
      "src/**/*.css",
      "assets/**",
      "data/**",
      "!data/base/raw/**",
      "LICENSE",
      "LICENSE-DATA.txt",
      "docs/DATA-LICENSES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/brand/parchment.ico"
    },
    "portable": {
      "artifactName": "Parchment.exe"
    },
    "npmRebuild": false
  }
}
