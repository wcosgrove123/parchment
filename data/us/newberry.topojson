]],[[2137]],[[2138]],[[2139]],[[2140]],[[2141]],[[2142]],[[2143]],[[2144]],[[-1304,2145]],[[2146,-1281]],[[-1394,2148,-1390,2149,-1397,-1396,-971,2150,2152,2153,-1299,-1298,-435,431,-1297,2147]]],"properties":{"id":"va_state","v":7,"name":"Virginia","full":"Virginia","abbr":"VA","type":"State","s":18630805,"e":18631101,"power":"us","change":"Virginia lost BERKELEY (W.Va.) to West Virginia.","cite":"(U.S. Rpts., 78:39 [Wallace, vol. 11]; U.S. Stat., vol. 14, res. 12[1866]/p. 350; W.Va. Acts 1863, 1st sess., ch. 35, sec. 1/pp. 33-35)"}},{"type":"MultiPolygon","arcs":[[[-1392,2133]],[[2134]],[[2135]],[[2136]],[[2137]],[[2138]],[[2139]],[[2140]],[[2141]],[[2142]],[[2143]],[[2144]],[[-1304,2145]],[[2146,-1281]],[[-1394,2148,-1390,2149,-1397,-1396,-971,2150,2152,2154,-1298,-435,431,-1297,2147]]],"properties":{"id":"va_state","v":8,"name":"Virginia","full":"Virginia","abbr":"VA","type":"State","s":18631102,"e":99991231,"power":"us","change":"The state of Virginia lost JEFFERSON (W.Va.) to West Virginia.","cite":"(U.S. Rpts., 78:39 [Wallace, vol. 11]; U.S. Stat., vol. 14, res. 12[1866]/p. 350; W.Va. Acts 1863, 1st sess., ch. 90, sec. 1/pp. 103-105)"}},{"type":"Polygon","arcs":[[-1409,-1408,-1253,-1495,2155]],"properties":{"id":"vt_republic","v":1,"name":"Vermont Republic","full":"Vermont Republic","abbr":"VT Rep","type":"Other","s":17830903,"e":17910303,"power":"disputed","change":"Vermont declared its independence from New York in 1777. Although not recognized as a separate state by the Continental Congress, Vermont functioned as an independent republic until statehood in 1791. Map depicts Vermont boundaries as of 3 Sep 1783.","cite":"(Slade, 70-73; Van Zandt, 64; Williamson, C., 82-84, map facing 95, 100-102, 112-113)"}},{"type":"Polygon","arcs":[[-1409,-1408,-1253,-1495,2155]],"properties":{"id":"vt_state","v":1,"name":"Vermont","full":"Vermont","abbr":"VT","type":"State","s":17910304,"e":99991231,"power":"us","change":"The state of Vermont was admitted to the Union. The boundary with New York was settled by a joint commission before statehood.","cite":"(Slade, 193; U.S. Stat., vol. 1, ch. 7 [1791]/p. 191)"}},{"type":"MultiPolygon","arcs":[[[1500]],[[1501]],[[1502]],[[1503]],[[1504]],[[1505]],[[1506]],[[1507]],[[1508]],[[1509]],[[1510]],[[1511]],[[1512]],[[1513]],[[1514]],[[1515]],[[1516]],[[1523]],[[1525]],[[1529]],[[1530]],[[1531]],[[1533]],[[1534]],[[1535]],[[1536]],[[1537]],[[1538]],[[1539]],[[1541]],[[1542]],[[1543]],[[1550]],[[1552]],[[1553]],[[1554]],[[1557]],[[2065,2060]],[[2066,-806,-805,-2065,2058]]],"properties":{"id":"wa_state","v":1,"name":"Washington","full":"Washington","abbr":"WA","type":"State","s":18891111,"e":99991231,"power":"us","change":"The state of Washington was created from Washington Territory; Washington Territory eliminated.","cite":"(U.S. Stat., vol. 25, ch. 180[1889], p. 676; U.S. Stat. pres. proc., vol. 26[1889], p. 10; Van Zandt, 155-156)"}},{"type":"MultiPolygon","arcs":[[[1500]],[[1501]],[[1502]],[[1503]],[[1504]],[[1505]],[[1506]],[[1507]],[[1508]],[[1509]],[[1510]],[[1511]],[[1512]],[[1513]],[[1514]],[[1515]],[[1516]],[[1523]],[[1525]],[[1529]],[[1530]],[[1531]],[[1533]],[[1534]],[[1535]],[[1536]],[[1537]],[[1538]],[[1539]],[[1541]],[[1542]],[[1543]],[[1550]],[[1552]],[[1553]],[[1554]],[[1557]],[[2065,2060]],[[2066,806,810,808,-468,-2069,-2068,-805,-2065,2058]]],"properties":{"id":"wa_terr","v":1,"name":"Washington Territory","full":"Washington Territory","abbr":"WA Terr","type":"Territory","s":18530302,"e":18590213,"power":"us","change":"The United States created Washington Territory from Oregon Territory; included all of present Washington and parts of present Idaho and Montana.","cite":"(Van Zandt, 155)"}},{"type":"MultiPolygon","arcs":[[[1500]],[[1501]],[[1502]],[[1503]],[[1504]],[[1505]],[[1506]],[[1507]],[[1508]],[[1509]],[[1510]],[[1511]],[[1512]],[[1513]],[[1514]],[[1515]],[[1516]],[[1523]],[[1525]],[[1529]],[[1530]],[[1531]],[[1533]],[[1534]],[[1535]],[[1536]],[[1537]],[[1538]],[[1539]],[[1541]],[[1542]],[[1543]],[[1550]],[[1552]],[[1553]],[[1554]],[[1557]],[[2065,2060]],[[2066,806,810,808,-468,-467,-466,-465,-464,-463,-462,-461,-460,501,502,-1335,809,798,799,800,801,802,803,-2065,2058]]],"properties":{"id":"wa_terr","v":2,"name":"Washington Territory","full":"Washington Territory","abbr":"WA Terr","type":"Territory","s":18590214,"e":18610301,"power":"us","change":"Washington Territory gained non-county area when the state of Oregon was created from Oregon Territory. Non-County Area 2 included parts of present Idaho, Montana, and Wyoming.","cite":"(Ore. Laws 1860, 1st reg. sess., pp. 28-30; Van Zandt, p. 155)"}},{"type":"MultiPolygon","arcs":[[[1500]],[[1501]],[[1502]],[[1503]],[[1504]],[[1505]],[[1506]],[[1507]],[[1508]],[[1509]],[[1510]],[[1511]],[[1512]],[[1513]],[[1514]],[[1515]],[[1516]],[[1523]],[[1525]],[[1529]],[[1530]],[[1531]],[[1533]],[[1534]],[[1535]],[[1536]],[[1537]],[[1538]],[[1539]],[[1541]],[[1542]],[[1543]],[[1550]],[[1552]],[[1553]],[[1554]],[[1557]],[[2065,2060]],[[2066,806,810,808,-468,-467,-466,-465,-464,-463,-462,-461,-460,501,-1405,-479,809,798,799,800,801,802,803,-2065,2058]]],"properties":{"id":"wa_terr","v":3,"name":"Washington Territory","full":"Washington Territory","abbr":"WA Terr","type":"Territory","s":18610302,"e":18630302,"power":"us","change":"Nebraska Territory gained part of SHOSHONE (Idaho).","cite":"(U.S. Stat., vol. 12, ch. 86 [1861]/pp. 239-244; Van Zandt, 134, 136-137)"}},{"type":"MultiPolygon","arcs":[[[1500]],[[1501]],[[1502]],[[1503]],[[1504]],[[1505]],[[1506]],[[1507]],[[1508]],[[1509]],[[1510]],[[1511]],[[1512]],[[1513]],[[1514]],[[1515]],[[1516]],[[1523]],[[1525]],[[1529]],[[1530]],[[1531]],[[1533]],[[1534]],[[1535]],[[1536]],[[1537]],[[1538]],[[1539]],[[1541]],[[1542]],[[1543]],[[1550]],[[1552]],[[1553]],[[1554]],[[1557]],[[2065,2060]],[[2066,-806,-805,-2065,2058]]],"properties":{"id":"wa_terr","v":4,"name":"Washington Territory","full":"Washington Territory","abbr":"WA Terr","type":"Territory","s":18630303,"e":18891110,"power":"us","change":"The United States created Idaho Territory from Dakota, Nebraska, and Washington Territories.","cite":"(U.S. Stat., vol. 12, ch. 117 [1863]/pp. 808-814; Van Zandt, 156-158)"}},{"type":"MultiPolygon","arcs":[[[857]],[[858]],[[859]],[[860]],[[861]],[[824]],[[826]],[[-1313,-1312,-1311,-1310,837,894,895,896,839,-812,-780,-790,-1317,833]],[[827]]],"properties":{"id":"wi_state","v":1,"name":"Wisconsin","full":"Wisconsin","abbr":"WI","type":"State","s":18480529,"e":19261121,"power":"us","change":"The state of Wisconsin was created from Wisconsin Territory. The area in present Minnesota between the Mississippi River and the state of Wisconsin continued as de facto Wisconsin Territory until the creation of Minnesota Territory on 3 March 1849.","cite":"(U.S. Stat., vol. 9, ch. 89 [1846]/pp. 56-58, and ch. 50 [1848]/pp. 233-235; Van Zandt, 128-130)"}},{"type":"MultiPolygon","arcs":[[[857]],[[858]],[[859]],[[860]],[[861]],[[864]],[[865]],[[866]],[[867]],[[868]],[[869]],[[2156,892]],[[2157,873]],[[2158,871]],[[824]],[[826]],[[-1313,-1312,-1311,-1310,837,894,895,896,839,-812,-780,-790,-1317,833]],[[827]]],"properties":{"id":"wi_state","v":2,"name":"Wisconsin","full":"Wisconsin","abbr":"WI","type":"State","s":19261122,"e":19360315,"power":"us","change":"An overlap was created when Wisconsin appeared to gain islands north of the Rock Island Passage from Michigan when the U.S. Supreme Court described the Wis.-Mich. boundary through Lake Michigan and Green Bay and introduced some unintentional errors.","cite":"(Martin, \"Michigan-Wisconsin,\" 143-145, 158; Paullin, 86, pl. 101)"}},{"type":"MultiPolygon","arcs":[[[857]],[[858]],[[859]],[[860]],[[861]],[[824]],[[826]],[[-1313,-1312,-1311,-1310,837,894,895,896,839,-812,-780,-790,-1317,833]],[[827]]],"properties":{"id":"wi_state","v":3,"name":"Wisconsin","full":"Wisconsin","abbr":"WI","type":"State","s":19360316,"e":99991231,"power":"us","change":"Dispute between Michigan and Wisconsin ended when the U.S. Supreme Court decreed the precise course of the revised Michigan-Wisconsin boundary through Green Bay and Lake Michigan.","cite":"(Martin, \"Second Wisconsin-Michigan,\" 86, 118-121)"}},{"type":"MultiPolygon","arcs":[[[857]],[[858]],[[859]],[[860]],[[861]],[[824]],[[825]],[[826]],[[827]],[[828]],[[829]],[[830]],[[831]],[[833,-1313,-1312,-1311,-1310,837,894,895,896,839,-812,780,781,782,783,784,785,448,484,450,451,452,487,790,791,792,793,471,794,846]]],"properties":{"id":"wi_terr","v":1,"name":"Wisconsin Territory","full":"Wisconsin Territory","abbr":"WI Terr","type":"Territory","s":18360703,"e":18380702,"power":"us","change":"The United States created Wisconsin Territory from Michigan Territory; included all of present Wisconsin, Iowa, and Minnesota; and parts of present North and South Dakota.","cite":"(Terr. Papers U.S., 27:41-52; U.S. Stat., vol. 5, ch. 54 [1836]/pp. 10-16)"}},{"type":"MultiPolygon","arcs":[[[857]],[[858]],[[859]],[[860]],[[861]],[[824]],[[825]],[[826]],[[827]],[[828]],[[829]],[[830]],[[831]],[[833,-1313,-1312,-1311,-1310,837,894,895,896,839,-812,-780,-790,-789,-788,846]]],"properties":{"id":"wi_terr","v":2,"name":"Wisconsin Territory","full":"Wisconsin Territory","abbr":"WI Terr","type":"Territory","s":18380703,"e":18480528,"power":"us","change":"The United States created Iowa Territory from Wisconsin Territory, encompassing all of Wisconsin Territory west of the Mississippi River.","cite":"(U.S. Stat., vol. 5, ch. 96 [1838]/pp. 235-241)"}},{"type":"MultiPolygon","arcs":[[[825]],[[828]],[[829]],[[830]],[[831]],[[1316,-789,-788,846]]],"properties":{"id":"wi_terrdefacto","v":1,"name":"Wisc. Terr. De Facto","full":"Wisconsin Territory De Facto","abbr":"WI Terr DF","type":"Unorganized Territory","s":18480529,"e":18490302,"power":"us","change":"The state of Wisconsin was created from Wisconsin Territory. The area in present Minnesota between the Mississippi River and the state of Wisconsin continued as de facto Wisconsin Territory until the creation of Minnesota Territory on 3 March 1849.","cite":"(U.S. Stat., vol. 9, ch. 89 [1846]/pp. 56-58, and ch. 50 [1848]/pp. 233-235; Van Zandt, 128-130)"}},{"type":"Polygon","arcs":[[-1301,-2152,-2151,-970,-1450,-2070]],"properties":{"id":"wv_state","v":1,"name":"West Virginia","full":"West Virginia","abbr":"WV","type":"State","s":18630620,"e":18630804,"power":"us","change":"The state of West Virginia was formally separated from Virginia and admitted to the Union. Most of West Virginia had been effectively independent of Virginia since June 1861.","cite":"(Swindler, 10:363)"}},{"type":"Polygon","arcs":[[-1301,-1300,-2154,-2153,-2151,-970,-1450,-2070]],"properties":{"id":"wv_state","v":2,"name":"West Virginia","full":"West Virginia","abbr":"WV","type":"State","s":18630805,"e":18631101,"power":"us","change":"BERKELEY was separated from Virginia and became a county in the state of West Virginia.","cite":"(U.S. Rpts., 78:39 [Wallace, vol. 11]; U.S. Stat., vol. 14, res. 12 [1866]/ p. 350; W.Va. Acts 1863, 1st sess., ch. 35, sec. 1/pp. 33-35)"}},{"type":"Polygon","arcs":[[-1301,-1300,-1299,-2155,-2153,-2151,-970,-1450,-2070]],"properties":{"id":"wv_state","v":3,"name":"West Virginia","full":"West Virginia","abbr":"WV","type":"State","s":18631102,"e":99991231,"power":"us","change":"JEFFERSON was separated from Virginia and became a county in the state of West Virginia.","cite":"(U.S. Rpts., 78:39 [Wallace, vol. 11]; U.S. Stat., vol. 14, res. 12 [1866]/ p. 350; W.Va. Acts 1863, 1st sess., ch. 90, sec. 1/pp. 103-105)"}},{"type":"Polygon","arcs":[[-473,457,475,-395,-408,-407,-406,476,-2133,-798,-797,-484,482]],"properties":{"id":"wy_state","v":1,"name":"Wyoming","full":"Wyoming","abbr":"WY","type":"State","s":18900710,"e":99991231,"power":"us","change":"The state of Wyoming was created from Wyoming Territory; Wyoming Territory eliminated.","cite":"(Wyoming Constitution 1889, art. 12 in Swindler, 10:493; U.S. Stat., vol. 26, ch. 664[1890]/pp. 222-226; Van Zandt, 145)"}},{"