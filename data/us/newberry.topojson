855]],[[920]],[[856]],[[921]],[[862]],[[863]],[[864]],[[865]],[[866]],[[867]],[[868]],[[869]],[[870,871]],[[872,873]],[[874]],[[875]],[[876]],[[877]],[[878]],[[879]],[[880]],[[932,933,934,935,936,937,938,-848,-855,897,931]],[[881]],[[882]],[[883]],[[922]],[[884]],[[885]],[[923]],[[924]],[[925]],[[926]],[[927]],[[928]],[[929]],[[886]],[[887,888,930,890,891,892,893,836,1309,1310,1311,1312,834]],[[832]]],"properties":{"id":"mi_terr","v":5,"name":"Michigan Territory","full":"Michigan Territory","abbr":"MI Terr","type":"Territory","s":18360703,"e":18370125,"power":"us","change":"The United States created Wisconsin Territory from Michigan Territory.","cite":"(U.S. Stat., vol. 5, ch. 54 [1836], sec. 1/p. 10; Terr. Papers U.S., 27:41-52)"}},{"type":"MultiPolygon","arcs":[[[825]],[[828]],[[829]],[[830]],[[831]],[[1316,789,-787,-447,-446,-445,794,846]]],"properties":{"id":"mn_state","v":1,"name":"Minnesota","full":"Minnesota","abbr":"MN","type":"State","s":18580511,"e":99991231,"power":"us","change":"The state of Minnesota was created from Minnesota Territory;  Minnesota Territory eliminated. The remainder of Minnesota Territory (west of the present state boundary) became unorganized federal territory.","cite":"(Schell, 72-77; U.S. Stat., vol. 11, ch. 60 [1857]/pp. 166-167 and ch. 31 [1858]/p. 285)"}},{"type":"MultiPolygon","arcs":[[[825]],[[828]],[[829]],[[830]],[[831]],[[1316,789,-787,447,448,484,450,451,452,487,790,791,792,793,471,794,846]]],"properties":{"id":"mn_terr","v":1,"name":"Minnesota Territory","full":"Minnesota Territory","abbr":"MN Terr","type":"Territory","s":18490303,"e":18580510,"power":"us","change":"The United States created Minnesota Territory from unorganized federal territory west of the Mississippi River (formerly part of Iowa Territory) and de facto Wisconsin Territory.","cite":"(U.S. Stat., vol. 9, ch. 121 [1849]/pp. 403-409)"}},{"type":"Polygon","arcs":[[-824,-977,984,-969,985,-339,-945,-957,1317,-784,-783,-782]],"properties":{"id":"mo_state","v":1,"name":"Missouri","full":"Missouri","abbr":"MO","type":"State","s":18210810,"e":18370327,"power":"us","change":"The state of Missouri was created from Missouri Territory, with all modern boundaries, except for the northwestern corner of the present state, which became unorganized federal territory.","cite":"(Terr. Papers U.S., 15:742-744; U.S. Stat., vol. 3, ch. 22[1820]/pp. 545-548)"}},{"type":"Polygon","arcs":[[-824,-977,984,-969,985,-339,-945,-957,-956,-955,-954,-953,1318,-785,-784,-783,-782]],"properties":{"id":"mo_state","v":2,"name":"Missouri","full":"Missouri","abbr":"MO","type":"State","s":18370328,"e":18381214,"power":"us","change":"The northwestern boundary of the state of Missouri was extended to the Missouri River, eliminating unorganized federal territory from Missouri.","cite":"(Mo. Laws 1836-1837, pub., p. 49; U.S. Stat., vol. 5, ch. 86[1836]/p. 34, and res. 2, p. 802)"}},{"type":"Polygon","arcs":[[-782,-824,-977,984,-969,985,-339,-945,-957,-956,-955,-954,-953,1318,-785,-784,1319]],"properties":{"id":"mo_state","v":3,"name":"Missouri","full":"Missouri","abbr":"MO","type":"State","s":18381215,"e":18490212,"power":"us","change":"Missouri legislature extended CLARK's boundary line north of the commonly accepted boundary between Missouri and Iowa Territory (the Indian boundary line established in 1816); the extension overlapped Iowa's VAN BUREN.","cite":"(Mo. Laws 1838-1839, pub., p. 22)"}},{"type":"Polygon","arcs":[[-824,-977,984,-969,985,-339,-945,-957,-956,-955,-954,-953,1318,-785,-784,-783,-782]],"properties":{"id":"mo_state","v":4,"name":"Missouri","full":"Missouri","abbr":"MO","type":"State","s":18490213,"e":19500802,"power":"us","change":"U.S. Supreme Court settled boundary dispute between Iowa and Missouri by rejecting both states' claims, choosing instead the commonly accepted boundary before the dispute arose and the present boundary between the two states.","cite":"(Landers. 647-648; Thomas 269-270)"}},{"type":"Polygon","arcs":[[-824,-977,984,-969,985,-339,-945,-957,-956,-961,-960,-953,1318,-785,-784,-783,-782]],"properties":{"id":"mo_state","v":5,"name":"Missouri","full":"Missouri","abbr":"MO","type":"State","s":19500803,"e":99991231,"power":"us","change":"Missouri and Kansas exchanged territory along the Missouri River from 40 degrees north latitude to the Kansas River. The change was made to accommodate shifts in the course of the Missouri River following the 1944 flood.","cite":"(U.S. Stat., vol. 64, ch. 519 [1950]/p. 397; Mo. Laws 1949, S.B. 141, p. 311; Kans. Laws 1949, 53d leg., chs. 196, 510/pp. 293-294, 837-838)"}},{"type":"Polygon","arcs":[[980,981,982,983,788,789,779,780,-824,-977,984,-969,985,327,328,329,330,331,986,333,987,988,989,990,-514,991,992,-511,-510,-509,-508,-507,-506,-505,-504,-503,-502,459,460,461,462,463,464,465,466,467,993]],"properties":{"id":"mo_terr","v":1,"name":"Missouri Territory","full":"Missouri Territory","abbr":"MO Terr","type":"Territory","s":18121207,"e":18181019,"power":"us","change":"Louisiana Territory renamed Missouri Territory.","cite":"(Terr. Papers U.S., 14:599-601; U.S. Stat., vol. 2, ch. 95[1812]/pp. 743-747)"}},{"type":"Polygon","arcs":[[787,788,789,779,780,-824,-977,984,-969,985,327,328,329,330,331,986,333,987,988,989,990,-514,991,992,-511,-510,-509,-508,-507,-506,-505,-504,-503,-502,459,460,461,462,463,464,465,466,467,468,469,470,471,794]],"properties":{"id":"mo_terr","v":2,"name":"Missouri Territory","full":"Missouri Territory","abbr":"MO Terr","type":"Territory","s":18181020,"e":18190221,"power":"us","change":"Area exchanged with British North America when a Convention of Commerce between Great Britain and the United States established 49 degrees north latitude, from the Lake of the Woods to the Rocky Mtns., as the northern boundary of the United States.","cite":"(Parry, 69: 294-297)"}},{"type":"Polygon","arcs":[[787,788,789,779,780,-824,-977,984,-969,985,327,328,329,330,1320,340,-337,-336,343,344,345,1321,347,348,349,945,946,1322,1323,1324,963,1325,1326,1327,1328,1329,1330,-503,-502,459,460,461,462,463,464,465,466,467,468,469,470,471,794]],"properties":{"id":"mo_terr","v":3,"name":"Missouri Territory","full":"Missouri Territory","abbr":"MO Terr","type":"Territory","s":18190222,"e":18190531,"power":"us","change":"Non-County Area exchanged with Spain as a result of the Adams-Onis Treaty with Spain on 22 February 1819.","cite":"(Mo. Terr. Laws 1813-1814, ch. 99, sec. 1/pp. 293-295)"}},{"type":"Polygon","arcs":[[787,788,789,779,780,-824,-977,984,-969,985,327,328,329,330,331,332,333,334,343,344,345,346,347,348,349,945,946,1322,1323,1324,963,1325,1326,1327,1328,1329,1330,-503,-502,459,460,461,462,463,464,465,466,467,468,469,470,471,794]],"properties":{"id":"mo_terr","v":4,"name":"Missouri Territory","full":"Missouri Territory","abbr":"MO Terr","type":"Territory","s":18190601,"e":18190703,"power":"us","change":"HEMPSTEAD created by Missouri Territory from ARKANSAS and non-county area. Uncertainty of boundary between Mexico and the U.S. resulted in competing claims to area in Texas. Act passed 15 December 1818, took effect 1 June 1819.","cite":"(Mo. Terr. Laws 1818-1819, ch. 232a, secs. 1-3/pp. 589-591)"}},{"type":"Polygon","arcs":[[787,788,789,779,780,-824,-977,984,-969,985,-339,-343,-342,-352,-351,945,946,1322,1323,1324,963,1325,1326,1327,1328,1329,1330,-503,-502,459,460,461,462,463,464,465,466,467,468,469,470,471,794]],"properties":{"id":"mo_terr","v":5,"name":"Missouri Territory","full":"Missouri Territory","abbr":"MO Terr","type":"Territory","s":18190704,"e":18210809,"power":"us","change":"The United States created Arkansas Territory from that part of Missouri Territory south of the parallel of 36 degrees, 30 minutes north latitude.","cite":"(U.S. Stat., vol. 3, ch. 49[1819]/pp. 493-496)"}},{"type":"Polygon","arcs":[[-317,-327,-315,-326,-313,-312,-311,-310,1331,-1210,-1209,751,752,753,-329,754]],"properties":{"id":"ms_state","v":1,"name":"Mississippi","full":"Mississippi","abbr":"MS","type":"State","s":18171210,"e":18200528,"power":"us","change":"The state of Mississippi was created from Mississippi Territory; Mississippi Territory was eliminated.","cite":"(U.S. Stat., vol. 3, ch. 23[1817], secs. 1-2/p. 348 and res. 1[1817]/p. 472; Van Zandt, 105)"}},{"type":"Polygon","arcs":[[-317,-327,-315,-326,-313,-312,-325,-324,308,1331,-1210,-1209,751,752,753,-329,754]],"properties":{"id":"ms_state","v":2,"name":"Mississippi","full":"Mississippi","abbr":"MS","type":"State","s":18200529,"e":99991231,"power":"us","change":"Surveyors demarcated the southern segment of the Alabama-Mississippi line, fixing the end point ten miles east of the mouth of the Pascagoula River.","cite":"(Van Zandt, 108-109)"}},{"type":"Polygon","arcs":[[320,748,749,750,751,752,-757,-756,319]],"properties":{"id":"ms_terr","v":1,"name":"Mississippi Terr.","full":"Mississippi Territory","abbr":"MS Terr","type":"Territory","s":17980407,"e":18040326,"power":"us","change":"The United States created Mississippi Territory in parts of present Mississippi and Alabama.","cite":"(U.S. Stat., 1:549-550)"}},{"type":"Polygon","arcs":[[318,319,320,748,749,750,751,752,753,-329,754,317]],"properties":{"id":"ms_terr","v":2,"name":"Mississippi Terr.","full":"Mississippi Territory","abbr":"MS Terr","type":"Territory","s":18040327,"e":18120429,"power":"us","change":"Mississippi Territory gained unorganized federal territory south of Tennessee (northern portions of present Mississippi and Alabama).","cite":"(U.S. Stat., vol. 2, ch. 61[1804], sec. 7/p. 305)"}},{"type":"MultiPolygon","arcs":[[[301]],[[302]],[[303]],[[304]],[[305,306]],[[307]],[[308,1331,-1210,-1209,751,752,753,-329,754,317,318,319,320,321,322]]],"properties":{"id":"ms_terr","v":3,"name":"Mississippi Terr.","full":"Mississippi Territory","abbr":"MS Terr","type":"Territory","s":18120430,"e":18170302,"power":"us","change":"The state of Louisiana was created from Orleans Territory; Orleans Territory eliminated. The area encompassed by PASCAGOULA (Orleans Terr.) was formally added to Mississippi Territory on 14 May 1812.","cite":"(U.S. Stat., vol. 2, ch. 50 [1812], secs. 1, 6/pp. 701, 704; ch. 57 [1812]/p. 708)"}},{"type":"Polygon","arcs":[[-317,-327,-315,-326,-313,-312,-311,-310,1331,-1210,-1209,751,752,753,-329,754]],"properties":{"id":"ms_terr","v":4,"name":"Mississippi Terr.","full":"Mississippi Territory","abbr":"MS Terr","type":"Territory","s":18170303,"e":18171209,"power":"us","change":"The United States created Alabama Territory from the eastern half of Mississippi Territory.","cite":"(U.S. Stat., vol. 3, ch. 58[1817], sec. 1/p. 371)"}},{"type":"Polygon","arcs":[[808,468,-475,-474,-483,483,464,465,-796,-808,810]],"properties":{"id":"mt_state","v":1,"name":"Montana","full":"Montana","abbr":"MT","type":"State","s":18891108,"e":99991231,"power":"us","change":"The state of Montana created from Montana Territory and to the Union by Presidential proclamation; Montana Territory eliminated.","cite":"(U.S. Stat., vol. 26, pp. 1551-1552 and vol. 25, ch. 180 [1889]/pp. 676-684; Swindler, 6:82-83)"}},{"type":"Polygon","arcs":[[808,468,-475,-474,-483,-482,465,-796,-808,810]],"properties":{"id":"mt_terr","v":1,"name":"Montana Territory","full":"Montana Territory","abbr":"MT Terr","type":"Territory","s":18640526,"e":18730216,"power":"us","change":"The United States created Montana Territory from Idaho Territory; boundaries were identical to the state of Montana, except for a small area of about two square miles (formerly part of MADISON) that became part of Dakota Territory.","cite":"(U.S. Stat., vol. 13, ch. 95 [1864], sec. 1/pp. 85-92; Sanders, Helen F., 1:329; Van Zandt, 145)"}},{"type":"Polygon","arcs":[[808,468,-475,-474,-483,483,464,465,-796,-808,810]],"properties":{"id":"mt_terr","v":2,"name":"Montana Territory","full":"Montana Territory","abbr":"MT Terr","type":"Territory","s":18730217,"e":18891107,"power":"us","change":"Montana Territory gained the small remnant of Dakota Territory that remained between Montana and Wyoming Territories.","cite":"(U.S. Stat., vol. 17, ch. 147 [1873]/p. 464; Van Zandt, 136, 145, 150)"}},{"type":"MultiPolygon","arcs":[[[365]],[[366]],[[367]],[[368]],[[369]],[[370]],[[371]],[[372]],[[373]],[[374]],[[375]],[[376]],[[377,378]],[[379]],[[380]],[[381]],[[382]],[[383]],[[384]],[[385]],[[386]],[[387]],[[388,389,1332,1333,-803,-802,-801,-800,-799,-810,1334,-1331,1335,1336,1337,1338,1339,1340,1341,-759,-758,516,-358,391,392]]],"properties":{"id":"mx_cession","v":1,"name":"Mexican Cession","full":"Mexican Cession","abbr":"Mex Cession","type":"Unorganized Territory","s":18480704,"e":18500908,"power":"us","change":"Treaty of Guadalupe-Hidalgo ended the war between Mexico and the United States. Area ceded by Mexico became Unorganized Federal Territory (non-county area) in the United States.","cite":"(U.S. Stat., vol. 9, pp. 922-943; Parry, 102: 29-59; Van Zandt, 11, 28-29; Walker and Bufkin, 19, 20A)"}},{"type":"MultiPolygon","arcs":[[[1339,1340,1341,-759,-758,516,358,361,362,363,364,360,-404,-403,-402,-511,1338]],[[1335,-504,-1331]]],"properties":{"id":"mx_cession","v":2,"name":"Mexican Cession","full":"Mexican Cession","abbr":"Mex Cession","type":"Unorganized Territory","s":18500909,"e":18501212,"power":"us","change":"The United States created Utah Territory from the territory ceded by Mexico in the Treaty of Guadalupe-Hidalgo (1848), from territory to be purchased from the state of Texas in December 1850, and from unorganized federal territory.","cite":"(U.S. Stat., vol. 9, ch. 49[1850]/pp. 446-452 and ch. 51[1850]/pp. 453-458; Van Zandt, 159)"}},{"type":"MultiPolygon","arcs":[[[1342]],[[1343,1344]],[[1345]],[[1346]],[[1347]],[[1348]],[[1349]],[[1350]],[[1351]],[[1352]],[[1353]],[[1354]],[[1355]],[[1356]],[[1357]],[[1358]],[[1359]],[[1360]],[[1361]],[[1362]],[[1363]],[[1364]],[[1365]],[[1366]],[[1367]],[[1368]],[[1369]],[[1370]],[[1371]],[[1372]],[[1373]],[[1374]],[[1375]],[[1376]],[[1377]],[[1378]],[[1379]],[[1380]],[[1381]],[[1382]],[[1383]],[[1384]],[[1385]],[[1386]],[[1387]],[[1388]],[[1389,1390,1391,1392]],[[1393,1394]],[[-975,-974,-973,-972,1395,1396,1397,1398,-746,-745,-318,-755,-328,-986,-968,-985,-976]]],"properties":{"id":"nc_state","v":1,"name":"North Carolina","full":"North Carolina","abbr":"NC","type":"State","s":17830903,"e":17900401,"power":"us","change":"North Carolina became an independent state on 4 July 1776. The map depicts state boundaries as of 3 September 1783.","cite":"(Declaration of Independence)"}},{"type":"MultiPolygon","arcs":[[[1342]],[[1343,1344]],[[1345]],[[1346]],[[1347]],[[1348]],[[1349]],[[1350]],[[1351]],[[1352]],[[1353]],[[1354]],[[1355]],[[1356]],[[1357]],[[1358]],[[1359]],[[1360]],[[1361]],[[1362]],[[1363]],[[1364]],[[1365]],[[1366]],[[1367]],[[1368]],[[1369]],[[1370]],[[1371]],[[1372]],[[1373]],[[1374]],[[1375]],[[1376]],[[1377]],[[1378]],[[1379]],[[1380]],[[1381]],[[1382]],[[1383]],[[1384]],[[1385]],[[1386]],[[1387]],[[1388]],[[1389,1390,1391,1392]],[[1393,1394]],[[1397,1398,-746,1399,1396]]],"properties":{"id":"nc_state","v":2,"name":"North Carolina","full":"North Carolina","abbr":"NC","type":"State","s":17900402,"e":99991231,"power":"us","change":"Congress accepted North Carolina's cession of its western lands (i.e. present Tennessee).","cite":"(Terr. Papers U.S., 4:13-17; U.S. Stat., vol. 1, ch. 6[1790], pp. 106-109)"}},{"type":"Polygon","arcs":[[444,1400,1401,791,1402,474,469,470,471]],"properties":{"id":"nd_state","v":1,"name":"North Dakota","full":"North Dakota","abbr":"ND","type":"State","s":18891102,"e":99991231,"power":"us","change":"The state of North Dakota was created from the Dakota Territory; Dakota Territory eliminated.","cite":"(U.S. Stat., vol. 25, ch. 180[1889]/pp. 676-684 and vol. 26, no. 5/pp. 1548-1549; Swindler, 7:526-527; Van Zandt, 134)"}},{"type":"Polygon","arcs":[[-456,-455,-454,-453,-452,-451,-450,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_state","v":1,"name":"Nebraska","full":"Nebraska","abbr":"NE","type":"State","s":18670301,"e":18710208,"power":"us","change":"The state of Nebraska was created from Nebraska Territory; Nebraska Territory eliminated.","cite":"(U.S. Stat., vol. 13, ch. 59 [1864]/pp. 47-50; U.S. Stat., vol. 14, ch. 36 [1867]/pp. 391-392 and proc. 9/pp. 820-821; Van Zandt, 137)"}},{"type":"Polygon","arcs":[[-456,-455,-454,-453,-452,-451,-485,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_state","v":2,"name":"Nebraska","full":"Nebraska","abbr":"NE","type":"State","s":18710209,"e":18730107,"power":"us","change":"DAKOTA gained small area from UNION (S.D.) in Dakota Territory when the Missouri River changed course.","cite":"(Neb. Laws 1871, 8th reg. sess., pp. 131-132; U.S. Stat., vol. 16, ch. 64[1870]/p. 93; Van Zandt, 137)"}},{"type":"Polygon","arcs":[[-487,-486,-454,-453,-452,-451,-485,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_state","v":3,"name":"Nebraska","full":"Nebraska","abbr":"NE","type":"State","s":18730108,"e":18820522,"power":"us","change":"TRIPP created by Dakota Territory in present South Dakota from GREGORY, TODD (original, extinct), and Non-County Area (1); TRIPP included a small piece of present Nebraska.","cite":"(Dak. Terr. Laws 1872, 10th sess., ch. 19, sec. 4/p. 45)"}},{"type":"Polygon","arcs":[[-487,-486,-489,-488,-453,-452,-451,-485,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_state","v":4,"name":"Nebraska","full":"Nebraska","abbr":"NE","type":"State","s":18820523,"e":19021103,"power":"us","change":"The state of Nebraska gained the area between 43 degrees north latitude and the Keya Paha and Niobrara Rivers from Dakota Territory. This territory became Non-County Area 8 in Nebraska.","cite":"(Neb. Laws 1882, 17th sess., ch. 4/p. 56; U.S. Stat., vol. 22, ch. 52[1882]/p. 35; Van Zandt, 136-138)"}},{"type":"Polygon","arcs":[[-487,-486,-489,-488,-453,1403,-451,-485,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_state","v":5,"name":"Nebraska","full":"Nebraska","abbr":"NE","type":"State","s":19021104,"e":99991231,"power":"us","change":"CLAY (S.D.) officially gained an island in the Missouri River from DIXON (Neb.); voters approved the gain 1006 to 25.","cite":"(Schell, History of Clay County, 102-104; S. Dak. Laws 1901, 7th sess., ch. 85/p. 109)"}},{"type":"Polygon","arcs":[[469,470,-794,-793,-792,-791,-488,-453,-452,-451,-485,-449,-786,-1319,-959,-967,-507,-506,-505,-504,-503,-502,459,460,461,462,463,464,465,466,467,468]],"properties":{"id":"ne_terr","v":1,"name":"Nebraska Territory","full":"Nebraska Territory","abbr":"NE Terr","type":"Territory","s":18540530,"e":18610227,"power":"us","change":"The United States created Nebraska Territory from unorganized federal territory. Nebraska Territory included all of present Nebraska and parts of present Colorado, Montana, North Dakota, South Dakota, and Wyoming.","cite":"(U.S. Stat., vol. 10, ch. 59[1854]/p. 277; Van Zandt, 136-137)"}},{"type":"Polygon","arcs":[[469,470,-794,-793,-792,-791,-488,-453,-452,-451,-485,-449,-786,-1319,-959,-396,-395,-408,-505,-504,-503,-502,459,460,461,462,463,464,465,466,467,468]],"properties":{"id":"ne_terr","v":2,"name":"Nebraska Territory","full":"Nebraska Territory","abbr":"NE Terr","type":"Territory","s":18610228,"e":18610301,"power":"us","change":"Nebraska Territory lost to creation of Colorado Territory; Nebraska Territory included all of present Nebraska and parts of present Montana, North Dakota, South Dakota, and Wyoming.","cite":"(U.S. Stat., vol. 12, ch. 59[1861]/pp. 172-177; Van Zandt, 136-137)"}},{"type":"Polygon","arcs":[[-458,-457,-456,-455,-454,-453,-452,-451,-450,-449,-786,-1319,-959,-396,-395,-408,-407,-406,476,477,478,1404,-502,-459]],"properties":{"id":"ne_terr","v":3,"name":"Nebraska Territory","full":"Nebraska Territory","abbr":"NE Terr","type":"Territory","s":18610302,"e":18630302,"power":"us","change":"Nebraska Territory gained from Utah and Washington Territories, lost to creation of Dakota Territory. Nebraska Territory included most of present Nebraska and part of Wyoming.","cite":"(Dak. Terr. Laws 1862, 1st sess., pp. 21-28; U.S. Stat., vol. 12, ch. 86[1861]/pp. 239-244; Van Zandt, 134, 136)"}},{"type":"Polygon","arcs":[[-456,-455,-454,-453,-452,-451,-450,-449,-786,-1319,-959,-396,-476,-458,-457]],"properties":{"id":"ne_terr","v":4,"name":"Nebraska Territory","full":"Nebraska Territory","abbr":"NE Terr","type":"Territory","s":18630303,"e":18670228,"power":"us","change":"Nebraska Territory lost the area in present Wyoming to creation of Idaho Territory.","cite":"(U.S. Stat., vol. 12, ch. 117[1863]/pp. 808-814; Van Zandt, 156)"}},{"type":"MultiPolygon","arcs":[[[-1256,1405]],[[-1271,1406,-1254,1407,1408,1409],[1410]]],"properties":{"id":"nh_state","v":1,"name":"New Hampshire","full":"New Hampshire","abbr":"NH","type":"State","s":17830903,"e":99991231,"power":"us","change":"New Hampshire became an independent state on 4 July 1776. The map depicts state boundaries as of 3 September 1783.","cite":"(Declaration of Independence)"}},{"type":"MultiPolygon","arcs":[[[1411]],[[1412]],[[1413]],[[1414]],[[1415]],[[1416]],[[1417]],[[1418]],[[1419]],[[1420]],[[1421]],[[1422]],[[1423]],[[1424]],[[1425]],[[1426]],[[1427]],[[1428]],[[-441,1429,1430,1431],[1432]]],"properties":{"id":"nj_state","v":1,"name":"New Jersey","full":"New Jersey","abbr":"NJ","type":"State","s":17830903,"e":99991231,"power":"us","change":"New Jersey became an independent state on 4 July 1776. The map depicts state boundaries as of 3 September 1783.","cite":"(Declaration of Independence)"}},{"type":"Polygon","arcs":[[1433,1434,1435,1341,759,760,-356,-355,-354,-404,-403,-402,-401,-400]],"properties":{"id":"nm_state","v":1,"name":"New Mexico","full":"New Mexico","abbr":"NM","type":"State","s":19120106,"e":99991231,"power":"us","change":"The state of New Mexico was created from New Mexico Territory; New Mexico Territory eliminated.","cite":"(U.S. Stat., vol. 34, Part 1, [ch. 3335 /p. 267])"}},{"type":"Polygon","arcs":[[-965,-964,-963,-962,1433,1434,1435,1341,-759,-758,516,3