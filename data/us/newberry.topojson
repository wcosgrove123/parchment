,456,472,473]],"properties":{"id":"sd_state","v":2,"name":"South Dakota","full":"South Dakota","abbr":"SD","type":"State","s":19021104,"e":99991231,"power":"us","change":"CLAY (S.D.) officially gained an island in the Missouri River from DIXON (Neb.); voters approved the gain 1006 to 25.","cite":"(Schell, History of Clay County, 102-104; S. Dak. Laws 1901, 7th sess., ch. 85/p. 109)"}},{"type":"Polygon","arcs":[[-975,-974,-973,-972,1395,-1400,-745,-318,-755,-328,-986,-968,-985,-976]],"properties":{"id":"sw_terr","v":1,"name":"Southwest Territory","full":"Southwest Territory","abbr":"SW Terr","type":"Territory","s":17900526,"e":17960531,"power":"us","change":"The United States created the Territory of the United States South of the River Ohio (Southwest Territory), covering the territory ceded in April 1790 by North Carolina (area of present Tennessee).","cite":"(Terr. Papers U.S., 4:18-19; U.S. Stat., vol. 1, ch. 14[1790], p. 123)"}},{"type":"Polygon","arcs":[[-975,-974,-973,-972,1395,-1400,-745,-318,-755,-328,-986,-968,-985,-976]],"properties":{"id":"tn_state","v":1,"name":"Tennessee","full":"Tennessee","abbr":"TN","type":"State","s":17960601,"e":18591129,"power":"us","change":"The state of Tennessee was created from the Territory of the United States South of the River Ohio (Southwest Territory); Southwest Territory eliminated.","cite":"(U.S. Stat., vol. 1, ch. 47[1796], pp. 491-492; Folmsbee, Corlew, and Mitchell 110)"}},{"type":"Polygon","arcs":[[-980,-974,-979,-972,1395,-1400,-745,-318,-755,-328,-986,-968,-985,-976]],"properties":{"id":"tn_state","v":2,"name":"Tennessee","full":"Tennessee","abbr":"TN","type":"State","s":18591130,"e":99991231,"power":"us","change":"ROBERTSON (Tenn.) and SUMNER (Tenn.) gained from SIMPSON (Ky.) when surveyors remarking the Kentucky-Tennessee boundary acted without authority and shifted the line around two small parcels.","cite":"(Sames, 107, 114)"}},{"type":"MultiPolygon","arcs":[[[2101]],[[2102]],[[2103]],[[2104]],[[2105]],[[2106