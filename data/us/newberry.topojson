0503,"power":"us","change":"State of Texas sold land in present Colorado, Kansas, New Mexico, Oklahoma, and Wyoming to the United States.","cite":"(U.S. Stat., vol. 9, ch. 49 [1850]/pp. 446-452 and appendix, sec. 10/pp. 1005-1006; Texas Laws 1850, 3d leg., 3d sess., ch. 2/p. 4; Van Zandt, 122)"}},{"type":"MultiPolygon","arcs":[[[2101]],[[2102]],[[2103]],[[2104]],[[2105]],[[2106]],[[2107]],[[2108]],[[2109]],[[2110]],[[2111]],[[2112]],[[2113]],[[2114]],[[2115]],[[2116]],[[2117]],[[2118]],[[2119]],[[2120]],[[2121]],[[2122]],[[2123]],[[2124]],[[2125]],[[2126]],[[2127]],[[2128]],[[2129,-760,-1342,-1436,-1435,-1499,-946,-350,-349,-348,-347,-346,-345,-344,335,336,-341,-340,-1208,-1202,2131]]],"properties":{"id":"tx_state","v":3,"name":"Texas","full":"Texas","abbr":"TX","type":"State","s":18960504,"e":99991231,"power":"us","change":"GREER eliminated from Texas when U.S. Supreme Court ruled that GREER was not within the boundaries of Texas, but was under the jurisdiction of the United States. GREER became a county in Oklahoma Territory on 4 May 1896.","cite":"(\"United States v. Texas,\" in U.S. Rpts., 162:1-91; U.S. Stat., vol. 29, ch. 155[1896]/pp. 113-114)"}},{"type":"Polygon","arcs":[[787,-984,-983,-982,-981,470,471,794]],"properties":{"id":"ub_area","v":1,"name":"Uncert. Bound. Area","full":"Uncertain Boundary Area","abbr":"UBA","type":"Other","s":18041001,"e":18181019,"power":"disputed","change":"The boundary from Lake of the Woods to the Rocky Mtns. between the United States and the British possessions was unsettled.","cite":"(Paullin, 60, pl. 93; Van Zandt, 25-26)"}},{"type":"MultiPolygon","arcs":[[[416]],[[419]],[[420]],[[421]],[[422]],[[423]],[[424]],[[902]],[[903]],[[904]],[[905]],[[906]],[[907]],[[908]],[[909]],[[910]],[[911]],[[912]],[[913]],[[914]],[[915]],[[916]],[[917]],[[918]],[[919]],[[855]],[[920]],[[856]],[[921]],[[857]],[[858]],[[859]],[[860]],[[861]],[[862]],[[863]],[[864]],[[865]],[[866]],[[867]],[[868]],[[869]],[[870,871]],[[872,873]],[[874]],[[875]],[[876]],[[877]],[[878]],[[879]],[[880]],[[881]],[[882]],[[883]],[[922]],[[884]],[[885]],[[923]],[[924]],[[925]],[[926]],[[927]],[[928]],[[929]],[[886]],[[824]],[[825]],[[826]],[[827]],[[828]],[[829]],[[830]],[[831]],[[832]],[[833,834,887,888,930,890,891,892,893,836,837,894,895,896,839,812,852,853,897,931,932,933,934,935,936,1446,418,1447,428,429,425,1448,1449,-978,850,851,822,823,-781,-780,-790,-789,-788,846]]],"properties":{"id":"uf_terr","v":1,"name":"Unorg. Fed. Terr.","full":"Unorganized Federal Territory","abbr":"UFT","type":"Unorganized Territory","s":17840301,"e":17860913,"power":"us","change":"All of present Illinois became unorganized federal territory when Virginia ceded its charter claims to the area to the United States. Other claims by Connecticut, Massachusetts, and New York to the area west of Pennsylvania were eliminated by 1786.","cite":"(Cappon, Petchenik, and Long, 62, 130-131; Hening, 11:571-575)"}},{"type":"MultiPolygon","arcs":[[[902]],[[903]],[[904]],[[905]],[[906]],[[907]],[[908]],[[909]],[[910]],[[911]],[[912]],[[913]],[[914]],[[915]],[[916]],[[917]],[[918]],[[919]],[[855]],[[920]],[[856]],[[921]],[[857]],[[858]],[[859]],[[860]],[[861]],[[862]],[[863]],[[864]],[[865]],[[866]],[[867]],[[868]],[[869]],[[870,871]],[[872,873]],[[874]],[[875]],[[876]],[[877]],[[878]],[[879]],[[880]],[[881]],[[882]],[[883]],[[922]],[[884]],[[885]],[[923]],[[924]],[[925]],[[926]],[[927]],[[928]],[[929]],[[886]],[[824]],[[825]],[[826]],[[827]],[[828]],[[829]],[[830]],[[831]],[[832]],[[833,834,887,888,930,890,891,892,893,836,837,894,895,896,839,812,852,853,897,931,932,933,934,935,936,1446,-418,1447,-428,-427,1448,1449,-978,850,851,822,823,-781,-780,-790,-789,-788,846]]],"properties":{"id":"uf_terr","v":2,"name":"Unorg. Fed. Terr.","full":"Unorganized Federal Territory","abbr":"UFT","type":"Unorganized Territory","s":17860914,"e":17870712,"power":"us","change":"The U.S. accepted Connecticut's cession of lands north and west of Pennsylvania and the Ohio River, except for a tract (Western Reserve) lying north of 41 degrees north latitude (Connecticut's southern line) and extending 120 miles west of Pennsylvania.","cite":"(Terr. Papers U.S., 2:24 n. 62)"}},{"type":"Polygon","arcs":[[-975,-974,-973,-972,1395,-1400,-745,-318,-755,-328,-986,-968,-985,-976]],"properties":{"id":"uf_terr","v":3,"name":"Unorg. Fed. Terr.","full":"Unorganized Federal Territory","abbr":"UFT","type":"Unorganized Territory","s":17900402,"e":17900525,"power":"us","change":"Congress accepted North Carolina's cession of its western lands (i.e. present Tennessee).","cite":"(Terr. Papers U.S., 4:13-17; U.S. Stat., vol. 1, ch. 6[1790], pp. 106-109)"}},{"type":"Polygon","arcs":[[318,755,756,753,-329,754,317]],"properties":{"id":"uf_terr","v":4,"name":"Unorg. Fed. Terr.","full":"Unorganized Federal Territory","abbr":"UFT","type":"Unorganized Territory","s":18020424,"e":18040326,"power":"us","change":"Georgia ceded to the United States all territory south of North Carolina and Tennessee, east of the Mississippi River, north of 31 degrees north latitude and west of the present limit of Georgia. The area became unorganized federal territory.","cite":"(Paullin, 83; Van Zandt, 100; Terr Papers US, 5:142-143)"}},{"type":"MultiPolygon","arcs":[[[857]],[[-839,894,941,896]],[[858]],[[859]],[[860]],[[861]],[[864]],[[865]],[[866]],[[867]],[[868]],[[869]],[[870,871]],[[872,873]],[[886]],[[939,891,892,893,-836,887]]],"properties":{"id":"uf_terr","v":5,"name":"Unorg. Fed. Terr.","full":"Unorganized Federal Territory","abbr":"UFT","type":"Unorganized Territory","s":18161211,"e":18181202,"power":"us","change":"Part of the Upper Peninsula of present Michigan and the extreme eastern part of present Wisconsin became unorganized federal territory when the state of Indiana was created from Indiana, Illinois, and Michigan Territories.","cite":"(U.S. Stat., vol. 3, ch. 57 [1816], secs. 1-2/p. 289, and res. 1 [1816]/p. 399; Van Zandt, 115)"}},{"type":"Polygon","arcs":[[787,788,789,779,780,7